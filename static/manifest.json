{
  "manifest_version": 3,
  "name": "Metaspry",
  "description": "One-click meta-tag audit and social preview for any page. Local-first, no account, no telemetry. OG, robots, sitemap, JSON-LD.",
  "version": "1.0.8",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Metaspry",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "offline_enabled": true,
  "minimum_chrome_version": "114",
  "permissions": ["tabs", "activeTab", "contextMenus", "storage", "sidePanel", "scripting"],
  "host_permissions": [
    "*://*/*"
  ]
}
