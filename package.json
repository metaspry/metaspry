{
	"name": "metaspry",
	"version": "1.0.31",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node removeInlineScript.cjs && node scripts/stamp-manifest.mjs && node scripts/check-remote-code.mjs",
		"package": "npm run build && node scripts/package-zip.mjs",
		"preview": "vite preview",
		"watch-src": "nodemon --watch src --ext svelte --exec \"npm run build\"",
		"gen-icons": "node scripts/gen-icons.mjs",
		"test": "vitest --run",
		"test:watch": "vitest",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test:coverage": "vitest --run --coverage",
		"test:e2e": "npm run build && playwright test",
		"contract:check": "node scripts/check-contract.mjs",
		"qa": "npm run check && npm run contract:check && npm test && npm run test:e2e"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^2.0.3",
		"@sveltejs/kit": "^1.27.4",
		"@types/chrome": "^0.0.251",
		"@vitest/coverage-v8": "^0.34.6",
		"autoprefixer": "^10.4.16",
		"happy-dom": "^20.14.5",
		"nodemon": "^3.0.1",
		"postcss": "^8.4.31",
		"sharp": "^0.34.5",
		"svelte": "^4.0.5",
		"svelte-check": "^3.8.6",
		"tailwindcss": "^3.3.5",
		"tiny-glob": "^0.2.9",
		"typescript": "^5.9.3",
		"vite": "^4.4.2",
		"vitest": "^0.34.6"
	},
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"firebase": "^12.15.0"
	}
}
